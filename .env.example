# OpenGraph.io API key - required for fetching OG images and favicons
# Get a key at https://dashboard.opengraph.io/
# Never commit .env to version control
OPENGRAPH_API_KEY=your_opengraph_api_key_here

# The server-side crawl (DEPLOYMENT.md). CRAWL_SECRET guards /api/crawl; TYPESAFE_API_KEY lets Jev
# pick which recommended brands get a search of their own. CRAWL_API_ORIGIN searches through
# another deployment's proxies, for running the crawl locally without the other keys.
# CRAWL_SECRET=
# TYPESAFE_API_KEY=
# CRAWL_API_ORIGIN=https://collabfinder.offerlab.com
