{
  "name": "brand-collab-finder",
  "version": "2.0.0",
  "description": "AI-powered brand collaboration finder",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/wrap-worker.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply offerlab-tools --remote",
    "db:migrate:local": "wrangler d1 migrations apply offerlab-tools --local",
    "build:icons": "node scripts/build-icons.mjs",
    "build:library": "node scripts/build-library.mjs",
    "crawl": "node scripts/crawl.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "miniflare": "^4.20260730.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "svelte-check": "^4.7.6"
  }
}
